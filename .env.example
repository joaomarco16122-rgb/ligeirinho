# Exemplo sem segredos. Gere valores locais únicos; nunca versione .env.
NODE_ENV=development
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://ligeirinho:SUBSTITUA_PELA_SENHA_LOCAL@localhost:5432/ligeirinho?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Ative somente com Nginx local e acesso direto à API bloqueado.
TRUST_LOCAL_PROXY=0
# Opcional: um único IP exato de proxy controlado; sem CIDR/wildcard.
# Prevalece sobre TRUST_LOCAL_PROXY quando definido.
TRUST_PROXY_ADDRESS=
OFFER_TTL_SECONDS=10
LOCATION_MAX_AGE_SECONDS=120
WAIT_MAX_SECONDS=900
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Em dispositivo Android, localhost aponta para o próprio aparelho.
# Use 10.0.2.2 no emulador oficial; em aparelho físico use HTTPS acessível.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1
# Apenas para executar o bootstrap; não há conta/senha padrão.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Integrações opcionais; valores secretos somente nas configurações seguras.
# Google Routes precisa de routes.googleapis.com autorizado e credencial real.
MAPS_PROVIDER=development
GOOGLE_MAPS_API_KEY=
# Adaptadores abaixo ainda exigem módulos/rotas persistentes; não estão ativos.
PUSH_PROVIDER=disabled
FCM_PROJECT_ID=
STORAGE_PROVIDER=disabled
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
PAYMENT_PROVIDER=disabled
PAYMENT_GATEWAY_ORIGIN=
PAYMENT_GATEWAY_TOKEN=

# Desenvolvimento legado; produção Docker seleciona supabase explicitamente.
AUTH_PROVIDER=legacy
SUPABASE_AUTH_ENABLED=0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_REQUIRE_EMAIL_CONFIRMED=1
# Web SSR lê a configuração pública no runtime, sem segredo no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
