# Modelo sem segredos. Copiar para local privado fora do checkout, modo0600.
# Nunca reutilize a base/credenciais de desenvolvimento nem imprima estes valores.
DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=
JWT_SECRET=
CORS_ORIGIN=https://SEU_DOMINIO
# Auth obrigatório nesta topologia; somente URL e chave pública/publicável.
# Nunca usar service-role, sb_secret_* ou senha do banco nestes campos.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Obrigatório para domínio personalizado; deve coincidir com o projeto real.
SUPABASE_PROJECT_REF=
# A API recusa distância de desenvolvimento em NODE_ENV=production.
GOOGLE_MAPS_API_KEY=
# /api/v1 usa mesma origem por proxy; alternativamente URL HTTPS da API.
PUBLIC_API_URL=/api/v1
# Bundle de CAs confiáveis usado somente durante os builds.
BUILD_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
LIGEIRINHO_API_IMAGE=ligeirinho-api:local
LIGEIRINHO_WEB_IMAGE=ligeirinho-web:local
LIGEIRINHO_MIGRATION_IMAGE=ligeirinho-migration:local

# Rede própria: escolher bloco livre e manter gateway dentro do mesmo subnet.
# Conferir rotas/rede privada/VPN antes de criar a rede na infraestrutura real.
PRODUCTION_DOCKER_SUBNET=172.30.237.0/24
PRODUCTION_DOCKER_GATEWAY=172.30.237.1
