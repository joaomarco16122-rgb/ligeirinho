# Configure os valores no Render > Environment ou em .env local (NAO envie .env ao GitHub).
DATABASE_URL=sqlite:///./joao_vendas.db
SESSION_SECRET=troque-por-um-segredo-forte-de-64-caracteres
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=crie-uma-senha-forte-apenas-para-o-bootstrap
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
# IA - cobrança separada da assinatura do ChatGPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# WhatsApp Cloud API - cadastro oficial no Meta for Developers
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
